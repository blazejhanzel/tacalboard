{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
        "label": "Connect to root container",
        "type": "shell",
        "command": "flatpak-spawn --host podman run -it --rm --entrypoint bash --workdir /mnt -v ./:/mnt:z node:24-slim",
        "problemMatcher": []
        },
        {
        "label": "Start Web dev container",
        "type": "shell",
        "command": "flatpak-spawn --host podman stop tcb-web; flatpak-spawn --host podman run --name tcb-web --rm --workdir /mnt/web --net host -v ./:/mnt:z node:24-slim npm run dev -- --host",
        "problemMatcher": []
      },
      {
        "label": "Start Server dev container",
        "type": "shell",
        "command": "flatpak-spawn --host podman stop tcb-server; flatpak-spawn --host podman run --name tcb-server --rm --workdir /mnt/server --net host -v ./:/mnt:z node:24-slim npm run dev",
        "problemMatcher": []
      }
    ]
}